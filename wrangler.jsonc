{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openentitlement",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./website/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "preview_urls": true,
  "build": {
    "command": "npx playwright install --with-deps chromium && npm run build",
    "watch_dir": [
      "website/src/pages",
      "website/src/styles",
      "website/src/content/docs/docs",
      "website/src/content/docs/problems",
      "spec",
      "GLOSSARY.md"
    ]
  }
}
