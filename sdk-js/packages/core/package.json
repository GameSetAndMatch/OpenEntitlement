{
  "name": "@openentitlement/core",
  "version": "0.2.0",
  "description": "Vendor-neutral entitlements API: features, limits, plans, overrides, grants. Reference SDK for the OpenEntitlement spec. Optional Postgres provider and lock.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authoring": {
      "source": "./src/authoring.ts",
      "types": "./dist/authoring.d.ts",
      "default": "./dist/authoring.js"
    },
    "./postgres": {
      "source": "./src/postgres.ts",
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./schema.sql": "./schema.sql"
  },
  "files": [
    "dist",
    "src",
    "schema.sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "keywords": [
    "entitlements",
    "plans",
    "limits",
    "quotas",
    "billing",
    "openfeature"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-entitlement/OpenEntitlement.git",
    "directory": "sdk-js/packages/core"
  },
  "homepage": "https://openentitlement.dev/docs/",
  "peerDependencies": {
    "zod": "^4.6.7",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
