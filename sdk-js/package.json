    "globals": "^17.14.0",
    "knip": "^6.44.1",
    "pg": "^8.23.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.72.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
