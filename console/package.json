{
  "name": "@openentitlement/console",
  "version": "0.3.0",
  "private": true,
  "description": "OpenEntitlement service: OEREP evaluation API, audited administration, and console.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:server": "node --conditions=source --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node --conditions=source server/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=source --test 'test/**/*.test.ts'",
    "test:setup": "node --conditions=source test/setup-browser.mjs",
    "start:workspace": "node --conditions=source server/workspace/main.ts",
    "dev:issuer": "node dev/issuer.ts",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry -o build/storybook",
    "test:workspaces": "node --conditions=source test/workspace-browser.mjs",
    "test:storybook": "node test/storybook-browser.mjs"
  },
  "dependencies": {
    "@openentitlement/core": "file:../sdk-js/packages/core",
    "openid-client": "6.8.9",
    "pg": "^8.13.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@types/node": "^24.0.0",
    "@types/oidc-provider": "9.13.1",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "oidc-provider": "9.13.3",
    "playwright": "^1.64.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.6",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "14.0.4"
    }
  }
}
